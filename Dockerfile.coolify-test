# syntax=docker/dockerfile:1
# webhook 自动部署已配置（2026-09-22，走 coolify 容器内网地址），push 到 test 分支会自动触发
#
# 仅供内部测试环境使用（Coolify 从源码构建），不用于正式发布。
# 正式发布走 .github/workflows 里的交叉编译 + Dockerfile 流程，不要改那一套。
#
# 这个文件比正式流程多做一步：正式发布是先在 CI 里单独编译好前端
# （komari-probe-web）打包成 dist.tar.zst 再喂给 Dockerfile；这里为了让
# Coolify 能直接从 server 仓库的源码独立构建出完整可用的镜像，把"拉前端仓库
# 并编译打包"这一步也内置进多阶段构建里。

# ---- 阶段一：编译前端 ----
# WEB_REPO_TOKEN 通过 Coolify 的构建时变量注入。这个仓库私有，且 Forgejo 实例
# 本身对匿名 git 操作也要求登录（REQUIRE_SIGNIN_VIEW），公开/私有都得认证。
#
# 本来想用 --mount=type=secret 避免 token 留痕，实测这套 Coolify（4.3.23）
# 的自定义应用变量只会传 --build-arg，不会带 --secret，/run/secrets/ 下面
# 什么都没有——2026-09-22 实测确认，只能退回用 ARG。这个 token 会在 Coolify
# 自己的部署日志和 BuildKit 中间层历史里留痕，只有我们能看到，风险可接受。
FROM node:23-alpine AS web-build
RUN apk add --no-cache git
WORKDIR /web
ARG WEB_REPO_HOST=forgejo.whimglow.com
ARG WEB_REPO_PATH=steve/komari-probe-web.git
ARG WEB_REF=test
ARG WEB_REPO_TOKEN
RUN git clone --depth=1 -b ${WEB_REF} "https://steve:${WEB_REPO_TOKEN}@${WEB_REPO_HOST}/${WEB_REPO_PATH}" . \
    && git remote set-url origin "https://${WEB_REPO_HOST}/${WEB_REPO_PATH}"
RUN npm ci
RUN npm run build

# ---- 阶段二：把前端产物打包成 server 期望的 dist.tar.zst ----
FROM alpine:3.21 AS web-pack
RUN apk add --no-cache tar zstd
WORKDIR /pack
COPY --from=web-build /web/dist ./dist
COPY --from=web-build /web/komari-theme.json ./komari-theme.json
RUN tar -cf dist.tar -C dist . && zstd -19 -T0 -f dist.tar -o dist.tar.zst

# ---- 阶段三：编译 Go 二进制（内嵌前端） ----
FROM golang:1.27-alpine AS go-build
RUN apk add --no-cache build-base
WORKDIR /src
COPY . .
COPY --from=web-pack /pack/dist.tar.zst internal/platform/frontend/defaultTheme/dist.tar.zst
COPY --from=web-pack /pack/komari-theme.json internal/platform/frontend/defaultTheme/komari-theme.json
ENV CGO_ENABLED=1
ENV GIN_MODE=release
ARG VERSION=test-local
ARG VERSION_HASH=unknown
RUN go build -trimpath \
    -ldflags="-s -w -X github.com/komari-monitor/komari/internal/version.CurrentVersion=${VERSION} -X github.com/komari-monitor/komari/internal/version.VersionHash=${VERSION_HASH}" \
    -o /out/komari .

# ---- 阶段四：运行镜像 ----
FROM alpine:3.21

WORKDIR /app

RUN apk add --no-cache ca-certificates curl tzdata

RUN mkdir -p /app/data

COPY --from=go-build /out/komari /app/komari

ENV GIN_MODE=release
ENV KOMARI_LISTEN=0.0.0.0:25774

EXPOSE 25774

CMD ["/app/komari", "server"]
